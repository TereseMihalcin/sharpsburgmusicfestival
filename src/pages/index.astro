---
import { Image } from 'astro:assets';
import 'bootstrap/dist/css/bootstrap.min.css';
import '../styles/global.css';
import Schedule from '../components/schedule.astro';
import Navigation from '../components/navigation.astro';
import Art from '../assets/Bicentennial-Founded-1826.jpg';
import Winner from '../assets/WinningLogo.png';

---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Sharpsburg Summer Jam</title>
	</head>
	<body>
		<Navigation />
		<div class="art ">
			<div class="intro container">
				<h1 class="title text-center text-uppercase">Sharpsburg Summer Jam</h1>
				<div class="info mt-4">
					<p class="date text-center mt-2 fs-1">Saturday September 19th, 2026</p>
					<p class="text-center mt-2 m-0 fs-3">1:00 PM – 7:00 PM, followed by the Sharpsburg Bicentennial Drone Show</p>
					<p class="text-center mt-2 m-0 fs-3">Kennedy Park, N. Canal Street, Sharpsburg, PA, 15215</p>
					<p class="text-center mt-2 m-0 fs-3">Free and Open to the Public</p>
				</div>
			</div>
			<div class="celebrate mb-5">
				<p class="text-center fs-1">Celebrating 200 Years of Sharpsburg</p>
			</div>
		</div>
		<div class="d-flex justify-content-around align-items-center mt-5 sched">
			<div class="art-obj">
				<img src={Art.src} />
			</div>
			<div class="sched-obj">
				<h2 class="text-center mb-5">Schedule of Events</h2>
				<Schedule />
			</div>
			<div class="winner-obj">
				<img src={Winner.src} />
			</div>
		</div>
		<div class="fooddrink mt-5">
			<div class="container pt-5 pb-5">
				<h2 class="text-center mb-5">Food and Drink</h2>
				<div class="row justify-content-center gap-4">
					<div class="text-center">
						<h4>Food Vendors</h4>
						<ul class="list-unstyled fs-4">
							<li>Yovi's Hot Dogs</li>
							<li>Gino Bros Pizza</li>
							<li>The Brinery</li>
							<li>Bruster's Ice Cream</li>
							<li>Funnel Cakes</li>
						</ul>
					</div>
					<div class="text-center">
						<h4>Drink Vendors</h4>
						<ul class="list-unstyled fs-4">
							<li>Hitchhiker Brewing</li>
							<li>Dancing Gnome</li>
							<li>Lucky Sign Spirits</li>
						</ul>
					</div>
				</div>
			</div>
		</div>
		<script>
			import 'bootstrap/dist/js/bootstrap.bundle.min.js';
		</script>
	</body>
</html>
