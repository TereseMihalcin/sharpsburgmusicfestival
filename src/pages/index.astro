---
import { Image } from 'astro:assets';
import 'bootstrap/dist/css/bootstrap.min.css';
import '../styles/global.css';
import Schedule from '../components/schedule.astro';
import Navigation from '../components/navigation.astro';
import Art from '../assets/Bicentennial-Founded-1826.jpg';

---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Sharpsburg Summer Jam</title>
	</head>
	<body>
		<Navigation />
		<div class="art">

			<div class="intro container">
				<h1 class="text-center text-uppercase">Sharpsburg Summer Jam</h1>
				<div class="info">
					<p class="date text-center mt-2 fs-1">Saturday September 19th, 2026</p>
					<p class="text-center mt-2 m-0 fs-4">1:00 PM – 7:00 PM, followed by the Sharpsburg Bicentennial Drone Show</p>
					<p class="text-center mt-2 m-0 fs-4">Kennedy Park, N. Canal Street, Sharpsburg, PA, 15215</p>
					<p class="text-center mt-2 m-0 fs-4">Free and Open to the Public</p>
				</div>
				<!-- <div class="row mt-4 gap-4 justify-content-center">
					<div class="col-12 col-md-6 p-3 info-card">
						<p class="fs-4">Sharpsburg, PA is gearing up for the ultimate celebration of sound, flavor, and community! The Sharpsburg Borough Parks & Recreation Commission is excited to announce its inaugural Sharpsburg Summer Jam Music Festival, taking place on Saturday, September 19, 2026, at Kennedy Park, N. Canal Street, Sharpsburg, PA 15215 as part of the Borough's Bicentennial celebration. This day-long community event is packed with live entertainment and local flavors and will feature acoustic and amplified music performances beginning at 1:00 PM.</p>
					</div>
					<div class="col-12 col-md-5 p-3 info-card">
						<p class="fs-4">Additional festivities include food trucks, local brewers, ice cream, funnel cakes, and family-friendly activities. The Summer Jam will culminate in a special Bicentennial Drone Show that will light up the evening sky in celebration of Sharpsburg's 200 years of history and community.  Admission is free and open to the public.</p>
					</div>
				</div> -->
				
				
			</div>
			<div class="celebrate">
				<p class="text-center fs-1">Celebrating 200 Years of Sharpsburg</p>
			</div>
		</div>
		<!-- <img src={Art.src} alt="vdsvd" style="max-width:100%;"/>  -->
		<h2 class="text-center mt-5">Schedule of Events</h2>
		<Schedule />
		<div class="footer d-flex mt-5">
			<img src={Art.src} />
		</div>

		<script>
			import 'bootstrap/dist/js/bootstrap.bundle.min.js';
		</script>
	</body>
</html>
