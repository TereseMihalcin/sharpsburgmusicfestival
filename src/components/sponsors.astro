---
import Northwest from '../assets/Northwest-Logo-Two-Line-Black300x.png';
import Secondharvest from '../assets/Second-Harvest.png';
import SNO from '../assets/Web_2026_SNO-Logo.png';
import Arts from '../assets/Arts-LOGO-for-print-transparent.png';
import Mainstreets from '../assets/MainStreets.png';
---

<div class="sponsors">
    <div class="container">
        <div class="row text-center pt-4">
            <h2>Thanks to our Sponsors</h2>
        </div>
        <div class="row justify-content-center gap-4 mt-5 mb-3">
            <div class="col-sm-6 col-10">
                <img src={Northwest.src} class="img-fluid" />
            </div>
        </div>
        <div class="row justify-content-around align-items-end">
             <div class="col-sm-3 col-6 pb-3">
                <img src={Arts.src} class="img-fluid" />
            </div>
            <div class="col-sm-3 col-6 pb-3">
                <img src={Secondharvest.src} class="img-fluid" />
            </div>
            <div class="col-sm-3 col-6 pb-3">
                <img src={SNO.src} class="img-fluid" />
            </div>
            <div class="col-sm-3 col-6 pb-3">
                <img src={Mainstreets.src} class="img-fluid" />
            </div>
        </div>
    </div>
</div>